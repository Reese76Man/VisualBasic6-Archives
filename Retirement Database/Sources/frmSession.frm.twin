        EndRoutine Me
    End If
    End Sub
    Private Sub chkNonMember_Click()
    EditCheck cmdUpdate, cmdAdd, cmdCancel
    If UserClick = True Then
        StartRoutine Me
        chkDeceased.Value = 0
